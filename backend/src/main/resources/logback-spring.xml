<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
        Базовый набор Spring Boot: подключает CONSOLE-appender, который при заданном
        свойстве logging.structured.format.console (см. application.yml, по умолчанию
        "ecs") автоматически переключается на структурный JSON-формат через встроенный
        StructuredLogEncoder (Spring Boot 3.4+, без сторонних зависимостей типа
        logstash-logback-encoder). Текущий MDC (включая correlationId, см.
        CorrelationContext/CorrelationIdFilter) автоматически попадает в каждую запись.

        Если logging.structured.format.console пустой (профиль dev, см. ниже) —
        appender работает в обычном текстовом режиме по CONSOLE_LOG_PATTERN.
    -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!--
        Профиль dev: человекочитаемый текстовый лог вместо JSON, для локальной разработки.
        CONSOLE_LOG_STRUCTURED_FORMAT не переопределяем здесь (logback не допускает
        пустое value у <property>) — вместо этого в dev-профиле задаём
        logging.structured.format.console="" в application-dev.yml/переменной окружения,
        а тут только меняем человекочитаемый паттерн на тот случай, если формат не задан.
    -->
    <springProfile name="dev">
        <property name="CONSOLE_LOG_PATTERN"
                   value="%d{yyyy-MM-dd HH:mm:ss} [%level] [%logger{36}] [%X{correlationId}] — %msg%n"/>
    </springProfile>

    <!-- Входящие сообщения — DEBUG -->
    <logger name="ru.protectinfotrans.eca.eventprocessor" level="DEBUG"/>

    <!-- Переходы между шагами, срабатывание ECA-правил — INFO -->
    <logger name="ru.protectinfotrans.eca.execution" level="INFO"/>

    <!-- Sequence Manager — INFO -->
    <logger name="ru.protectinfotrans.eca.sequence" level="INFO"/>

    <!-- Integration Adapter — INFO -->
    <logger name="ru.protectinfotrans.eca.integration" level="INFO"/>

    <!-- User/Auth — INFO -->
    <logger name="ru.protectinfotrans.eca.user" level="INFO"/>

    <!-- Spring Modulith events — INFO -->
    <logger name="org.springframework.modulith" level="INFO"/>

    <!-- Spring Security — WARN (убрать шум) -->
    <logger name="org.springframework.security" level="WARN"/>

    <!-- Hibernate SQL — WARN (убрать шум) -->
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.hibernate.SQL" level="WARN"/>

    <!-- Flyway — INFO -->
    <logger name="org.flywaydb" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>

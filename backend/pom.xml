<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>ru.protectinfotrans</groupId>
    <artifactId>eca-system</artifactId>
    <version>1.0.0</version>
    <name>ECA System</name>
    <description>Event-Condition-Action system for aviation message processing</description>

    <properties>
        <java.version>21</java.version>
        <!-- Security-патчи поверх Boot 3.5.16 (NVD 2026-07/08, см. owasp-suppressions.xml и PROGRESS Фаза 8+):
             tomcat 10.1.55 -> .56 (CVE-2026-53434/55276/53404) -> .59 (2026-08-31: CVE-2026-65182/83/
             65905/65927/66422/68525/68569/68763/59083/59084/65637 у .56, все CVSS>=7, gate
             security-scan красный; fixed-версия по NVD .58, но такого артефакта в Maven Central нет
             — взята ближайшая существующая .59); log4j 2.24.3 -> 2.26.1 (CVE-2026-34477..81).
             Свойства управляются spring-boot-parent — переопределение поднимает ВСЕ артефакты группы. -->
        <tomcat.version>10.1.59</tomcat.version>
        <log4j2.version>2.26.1</log4j2.version>
        <!-- swagger-ui webjar, вендоренный внутрь springdoc-openapi-starter-webmvc-ui (2.8.4 тянет
             5.18.2): бандлит DOMPurify 3.1.6, CVE-2026-65898 (CVSS 7.2, XSS через уязвимость
             setConfig()/allowlist-pollution), исправлено в DOMPurify 3.4.11. springdoc сам ещё не
             поднял версию (латест patch-линии 2.8.x на момент фикса); override транзитивной
             org.webjars:swagger-ui в dependencyManagement ниже поднимает бандл независимо. -->
        <webjars-swagger-ui.version>5.32.14</webjars-swagger-ui.version>
        <spring-modulith.version>1.3.1</spring-modulith.version>
        <easy-rules.version>4.1.0</easy-rules.version>
        <jjwt.version>0.12.6</jjwt.version>
        <springdoc.version>2.8.4</springdoc.version>
        <!-- Фаза 3 (прогон апгрейда): rate limiting. Apache-2.0 (совместимо с Реестром РФ).
             Координата bucket4j_jdk17-core — актуальная для JDK 17+ (бывшая bucket4j-core
             задепрекейчена после 8.10). Только in-memory local bucket — без транзитивных зависимостей. -->
        <bucket4j.version>8.19.0</bucket4j.version>
        <testcontainers.version>1.20.4</testcontainers.version>
        <jacoco.version>0.8.15</jacoco.version>
        <license-maven-plugin.version>2.4.0</license-maven-plugin.version>
        <!-- P4-4: SAST / сканирование зависимостей (профиль security-scan, не в обычной сборке) -->
        <dependency-check-maven.version>10.0.4</dependency-check-maven.version>
        <spotbugs-maven-plugin.version>4.8.6.4</spotbugs-maven-plugin.version>
        <findsecbugs-plugin.version>1.13.0</findsecbugs-plugin.version>
    </properties>

    <dependencies>
        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- P7-4: raw WebSocket эндпоинт /ws/eca для реал-тайм статусов инстансов -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- P5-1: реестр метрик Prometheus → эндпоинт /actuator/prometheus (scrape). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
            P5-2: сквозная трассировка OpenTelemetry. Версии управляются Spring Boot BOM
            (spring-boot-dependencies, parent этого POM) — без явных версий, как и остальные
            Boot-управляемые зависимости.
            - micrometer-tracing-bridge-otel: мост Micrometer Observation API -> OTel SDK
              (Span/Tracer), приносит транзитивно io.micrometer:context-propagation
              (ContextSnapshot — используется TracingTaskDecorator для проброса контекста
              через @Async-границу Spring Modulith @ApplicationModuleListener, см.
              ObservabilityAsyncConfig).
            - opentelemetry-exporter-otlp: экспорт по OTLP в САМОСТОЯТЕЛЬНО развёртываемый
              коллектор (импортозамещение — без зарубежных проприетарных SaaS, CLAUDE.md).
              Endpoint берётся из management.otlp.tracing.endpoint (env), в dev/тестах экспорт
              выключен (management.otlp.tracing.export.enabled=false) — без внешних
              зависимостей при сборке/тестах.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
            <scope>runtime</scope>
            <!-- Дефолтный HTTP-сендер OTLP — OkHttp — тянет okhttp/okio/kotlin-stdlib
                 (kotlin-stdlib 1.9.25: CVE-2026-53914 CVSS 9.8). Меняем на сендер поверх
                 JDK HttpClient — три транзитива исчезают из артефакта целиком
                 (заодно минус зарубежный стек в поставке — импортозамещение). -->
            <exclusions>
                <exclusion>
                    <groupId>io.opentelemetry</groupId>
                    <artifactId>opentelemetry-exporter-sender-okhttp</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-sender-jdk</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring Modulith -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-jpa</artifactId>
        </dependency>

        <!-- Easy Rules - ECA Engine -->
        <dependency>
            <groupId>org.jeasy</groupId>
            <artifactId>easy-rules-core</artifactId>
            <version>${easy-rules.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jeasy</groupId>
            <artifactId>easy-rules-support</artifactId>
            <version>${easy-rules.version}</version>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- API Documentation -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Фаза 3 (прогон апгрейда): rate limiting (bucket4j, token bucket in-memory).
             Брутфорс /api/v1/auth/** и флуд открытого ACARS-ингеста /api/v1/messages/**. -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-core</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            P5-2: InMemorySpanExporter — проверка сквозной трассировки в тестах (span'ы/атрибуты/
            связность одного traceId через @Async-границу @ApplicationModuleListener) без реального
            OTLP-коллектора. Версия управляется тем же opentelemetry-bom, что Spring Boot
            импортирует для opentelemetry-exporter-otlp/micrometer-tracing-bridge-otel (см. выше) —
            без явной версии, гарантированно совместима.
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-testing</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.webjars</groupId>
                <artifactId>swagger-ui</artifactId>
                <version>${webjars-swagger-ui.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- StackOverflowError на GitHub Actions runners (найдено 2026-08-28):
                         ExecutionService.advanceExecution/executeTransition — прямая взаимная
                         рекурсия (приватные перегрузки, вызываются внутри уже открытой
                         @Transactional-транзакции — прокси НЕ переисполняется на каждой итерации)
                         до MAX_SYNCHRONOUS_TRANSITIONS=1000. Локально (Windows, дефолтный -Xss)
                         хватает, на CI-раннере (Linux) — нет: P1_2_..InfiniteLoopProtectionTests
                         воспроизводимо падал StackOverflowError ДО того, как срабатывал лимит-чек.
                         Эмпирически подтверждено: -Xss512k падает, -Xss1m проходит — 8m даёт
                         большой запас. @{argLine} (не ${argLine}) — отложенное разрешение, чтобы
                         подхватить javaagent, который jacoco:prepare-agent устанавливает в это же
                         свойство позже в жизненном цикле сборки. -->
                    <argLine>-Xss8m @{argLine}</argLine>
                    <environmentVariables>
                        <DOCKER_HOST>${docker.host}</DOCKER_HOST>
                    </environmentVariables>
                    <!-- Фаза 2 (стабилизация): выключаем авто-тик @Scheduled-поллеров во всех
                         тестовых форках. Иначе фоновый тик (напр. OutboundMessageDeliveryScheduler)
                         может взять блокировку таблицы, а межтестовый Flyway-clean (DROP TABLE)
                         зависнет в ожидании этой блокировки без таймаута (наблюдался подвисший
                         прогон). Тесты вызывают методы опроса напрямую — покрытие не страдает.
                         Прод: свойство не задано → SchedulingConfig matchIfMissing=true → включено. -->
                    <systemPropertyVariables>
                        <app.scheduling.enabled>false</app.scheduling.enabled>
                        <!-- Фаза 3: лимитер пассивен в тестах — не режет высоконагруженные
                             интеграционные тесты ингеста/логина. Логика лимитера покрыта
                             юнит-тестом RateLimitFilterTest (enabled=true явно). -->
                        <app.ratelimit.enabled>false</app.ratelimit.enabled>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!--
                        ВРЕМЕННЫЙ baseline-порог покрытия (P0-1, RUN_PLAN.md).
                        Фактическое измеренное покрытие на момент введения гейта (2026-06-19,
                        mvn -B verify, локальный прогон): INSTRUCTION ~92.7%, LINE ~91.1%.
                        Порог ниже измеренного, чтобы не блокировать текущий зелёный пайплайн
                        небольшими погрешностями округления/окружения CI.
                        Целевой порог по CLAUDE.md — 85% (уже фактически достигнут и превышен),
                        но эта project-wide цифра в CLAUDE.md устарела и должна быть отдельно
                        актуализирована. Любое последующее повышение порога — отдельным тикетом,
                        по мере роста реального покрытия, порог НЕЛЬЗЯ снижать без ревью.
                    -->
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.88</minimum>
                                        </limit>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                License report зависимостей (P0-6, RUN_PLAN.md).
                Цель P0 — ИНФОРМАЦИОННЫЙ отчёт по лицензиям всех зависимостей (включая
                транзитивные), без фейла сборки по конкретным лицензиям — политику
                запрещённых/разрешённых лицензий вводит compliance отдельным тикетом
                (см. docs/security/fstec-checklist.md, раздел "Включение в Реестр
                российского ПО" / лицензионная чистота перед P8-3).
                Goal aggregate-third-party-report генерирует человекочитаемый HTML-отчёт
                (target/site/aggregate-third-party-report.html) со списком зависимостей,
                их лицензий и координат — публикуется как CI-артефакт (см. ci.yml).
                Привязан к фазе verify, чтобы отчёт обновлялся вместе с обычной сборкой
                (`mvn verify`), но НЕ влияет на её результат — сам goal не имеет
                fail-конфигурации.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${license-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>aggregate-third-party-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>aggregate-third-party-report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          P4-4: профиль security-scan — OWASP Dependency-Check + SpotBugs/FindSecBugs.
          ВЫНЕСЕН в отдельный профиль (не в обычный mvn verify): эти сканы медленные
          (Dependency-Check скачивает базу NVD) и запускаются отдельным CI-job'ом
          (.github/workflows/ci.yml, job security-scan), фейлят сборку на High/Critical.
          Запуск локально/в CI: mvn -Psecurity-scan dependency-check:check spotbugs:check
        -->
        <profile>
            <id>security-scan</id>
            <build>
                <plugins>
                    <!-- OWASP Dependency-Check: CVE в зависимостях. Фейл при CVSS >= 7 (High/Critical). -->
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${dependency-check-maven.version}</version>
                        <configuration>
                            <!-- 7.0 = High; 9.0+ = Critical. Фейлим на High и выше. -->
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                            </formats>
                            <!-- NVD требует API-ключ (иначе жёсткий rate-limit). В CI — secret NVD_API_KEY. -->
                            <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
                            <!-- Файл подавления документированных ложноположительных (изначально пуст). -->
                            <suppressionFiles>
                                <suppressionFile>${project.basedir}/owasp-suppressions.xml</suppressionFile>
                            </suppressionFiles>
                            <!-- Тестовые/опциональные scope не входят в поставку — не сканируем. -->
                            <skipTestScope>true</skipTestScope>
                            <!--
                                Sonatype OSS Index отключён: без настроенных токенов OSS Index
                                анализатор возвращает HTTP 401 и ломает сборку AnalysisException.
                                Основным источником CVE является NVD (nvdApiKey через env.NVD_API_KEY).
                                Правильное имя параметра (plugin.xml): ossindexAnalyzerEnabled (lowercase 'i').
                                ossIndexWarnOnlyOnRemoteErrors не перехватывает 401 — нужен полный disable.
                                При необходимости включить: убрать этот элемент и добавить
                                ossIndexUsername/ossIndexPassword через секреты репозитория.
                            -->
                            <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                        </configuration>
                    </plugin>
                    <!-- SpotBugs + FindSecBugs: статический анализ безопасности байткода. -->
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <version>${spotbugs-maven-plugin.version}</version>
                        <configuration>
                            <effort>Max</effort>
                            <!-- P4-4 DoD: фейл на High/Critical. threshold=High → блокируют только
                                 High-приоритетные security-находки; Medium (напр. CRLF-log-injection)
                                 репортятся в отчёт, но не валят гейт (трекаются отдельно). -->
                            <threshold>High</threshold>
                            <failOnError>true</failOnError>
                            <!-- Анализируем только наш main-код (не тесты). -->
                            <includeTests>false</includeTests>
                            <!-- Фильтр: только security-категория (FindSecBugs). -->
                            <includeFilterFile>${project.basedir}/spotbugs-security-include.xml</includeFilterFile>
                            <plugins>
                                <plugin>
                                    <groupId>com.h3xstream.findsecbugs</groupId>
                                    <artifactId>findsecbugs-plugin</artifactId>
                                    <version>${findsecbugs-plugin.version}</version>
                                </plugin>
                            </plugins>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Профиль для Docker Desktop на Windows (TCP вместо Unix socket) -->
        <profile>
            <id>windows-docker</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <docker.host>tcp://localhost:2375</docker.host>
            </properties>
        </profile>
    </profiles>

</project>

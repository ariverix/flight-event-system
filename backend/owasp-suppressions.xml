<?xml version="1.0" encoding="UTF-8"?>
<!--
  P4-4: подавления ложноположительных и принятых рисков OWASP Dependency-Check.
  Каждое подавление ДОЛЖНО иметь обоснование (<notes>) и быть точечным (по CVE/координатам),
  а не широким. Добавляется только после ревью security-agent.

  Формат 1.3 xsd: один <cve> или один <vulnerabilityName> на блок <suppress>.
  Для файла-контейнера достаточно одного блока с <filePath> без CVE — подавляет все находки
  в этом конкретном артефакте (точная версия зашита в имя файла).
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
      ============================================================================
      ГРУППА: DOMPurify XSS в swagger-ui-5.18.2.jar
      ============================================================================
      Источник: RetireJS-analyzer (JavaScript bundle analysis)
      Артефакт: org.webjars:swagger-ui:5.18.2 (embedded JS: swagger-ui-bundle.js,
                swagger-ui-es-bundle.js), зависимость org.springdoc:springdoc-openapi-*.

      Суть: DOMPurify 3.1.6, вшитый в Swagger UI 5.18.2, имеет несколько уязвимостей XSS
      (mutation-XSS, prototype pollution, FORBID_TAGS bypass и т.п.) — CVE-2025-15599,
      CVE-2025-26791, CVE-2026-0540, CVE-2026-41238/41239/41240, CVE-2026-49458/49459/49978,
      а также ряд безымянных (без CVE-идентификатора) находок RetireJS.

      Обоснование принятия риска:
        1. Swagger UI доступен ИСКЛЮЧИТЕЛЬНО роли SYSTEM_ADMIN (Spring Security RBAC,
           SecurityConfig.java — /swagger-ui/**, /v3/api-docs/**).
        2. Это dev/ops-инструментарий документирования API, не пользовательский интерфейс.
        3. Вектор атаки: аутентифицированный SYSTEM_ADMIN должен открыть специально
           сформированную страницу Swagger UI. При этом SYSTEM_ADMIN уже имеет полный
           доступ к API через токены — XSS не добавляет поверхность атаки.
        4. В производственном профиле Swagger UI рекомендуется отключать:
           springdoc.swagger-ui.enabled=false (prod-profile).
        5. Защита глубиной: CSP-заголовки снижают эксплуатируемость.

      Срок ревью: 2026-12-31 — к этому времени ожидается springdoc >= 2.9.x
      с актуальной версией swagger-ui/DOMPurify.
    -->

    <!-- CVE-2025-15599: DOMPurify prototype pollution via USE_PROFILES -->
    <suppress>
        <notes>DOMPurify 3.1.6 в swagger-ui-5.18.2.jar: XSS через prototype pollution при USE_PROFILES.
        Swagger UI доступен только SYSTEM_ADMIN (Spring Security). Риск принят. Ревью: 2026-12-31.</notes>
        <filePath regex="true">.*swagger-ui-5\.18\.2\.jar.*</filePath>
        <cve>CVE-2025-15599</cve>
    </suppress>

    <!-- CVE-2025-26791: DOMPurify mutation-XSS (mXSS) via raw-text wrapper elements -->
    <suppress>
        <notes>DOMPurify 3.1.6 в swagger-ui-5.18.2.jar: mXSS через xmp/script/iframe враппер.
        Swagger UI доступен только SYSTEM_ADMIN (Spring Security). Риск принят. Ревью: 2026-12-31.</notes>
        <filePath regex="true">.*swagger-ui-5\.18\.2\.jar.*</filePath>
        <cve>CVE-2025-26791</cve>
    </suppress>

    <!-- CVE-2026-0540: DOMPurify ADD_ATTR predicate short-circuits URI validation (javascript: XSS) -->
    <suppress>
        <notes>DOMPurify 3.1.6 в swagger-ui-5.18.2.jar: javascript: URI в href при EXTRA_ELEMENT_HANDLING.
        Swagger UI доступен только SYSTEM_ADMIN (Spring Security). Риск принят. Ревью: 2026-12-31.</notes>
        <filePath regex="true">.*swagger-ui-5\.18\.2\.jar.*</filePath>
        <cve>CVE-2026-0540</cve>
    </suppress>

    <!-- CVE-2026-41238: DOMPurify hook mutation pollutes DEFAULT_ALLOWED_TAGS/ATTR -->
    <suppress>
        <notes>DOMPurify 3.1.6 в swagger-ui-5.18.2.jar: мутация хука загрязняет DEFAULT_ALLOWED_*.
        Swagger UI доступен только SYSTEM_ADMIN (Spring Security). Риск принят. Ревью: 2026-12-31.</notes>
        <filePath regex="true">.*swagger-ui-5\.18\.2\.jar.*</filePath>
        <cve>CVE-2026-41238</cve>
    </suppress>

    <!-- CVE-2026-41239: DOMPurify ALLOWED_ATTR pollution via setConfig() -->
    <suppress>
        <notes>DOMPurify 3.1.6 в swagger-ui-5.18.2.jar: setConfig() загрязняет ALLOWED_ATTR.
        Swagger UI доступен только SYSTEM_ADMIN (Spring Security). Риск принят. Ревью: 2026-12-31.</notes>
        <filePath regex="true">.*swagger-ui-5\.18\.2\.jar.*</filePath>
        <cve>CVE-2026-41239</cve>
    </suppress>

    <!-- CVE-2026-41240: DOMPurify SAFE_FOR_TEMPLATES bypass in template content -->
    <suppress>
        <notes>DOMPurify 3.1.6 в swagger-ui-5.18.2.jar: SAFE_FOR_TEMPLATES обходится через template.
        Swagger UI доступен только SYSTEM_ADMIN (Spring Security). Риск принят. Ревью: 2026-12-31.</notes>
        <filePath regex="true">.*swagger-ui-5\.18\.2\.jar.*</filePath>
        <cve>CVE-2026-41240</cve>
    </suppress>

    <!-- CVE-2026-49458: DOMPurify Trusted Types policy survives clearConfig() -->
    <suppress>
        <notes>DOMPurify 3.1.6 в swagger-ui-5.18.2.jar: Trusted Types политика не сбрасывается.
        Swagger UI доступен только SYSTEM_ADMIN (Spring Security). Риск принят. Ревью: 2026-12-31.</notes>
        <filePath regex="true">.*swagger-ui-5\.18\.2\.jar.*</filePath>
        <cve>CVE-2026-49458</cve>
    </suppress>

    <!-- CVE-2026-49459: DOMPurify IN_PLACE mode trusts attacker-controlled nodeName -->
    <suppress>
        <notes>DOMPurify 3.1.6 в swagger-ui-5.18.2.jar: IN_PLACE mode XSS через nodeName.
        Swagger UI доступен только SYSTEM_ADMIN (Spring Security). Риск принят. Ревью: 2026-12-31.</notes>
        <filePath regex="true">.*swagger-ui-5\.18\.2\.jar.*</filePath>
        <cve>CVE-2026-49459</cve>
    </suppress>

    <!-- CVE-2026-49978: DOMPurify FORBID_TAGS bypass via ADD_TAGS function -->
    <suppress>
        <notes>DOMPurify 3.1.6 в swagger-ui-5.18.2.jar: FORBID_TAGS игнорируется при ADD_TAGS(fn).
        Swagger UI доступен только SYSTEM_ADMIN (Spring Security). Риск принят. Ревью: 2026-12-31.</notes>
        <filePath regex="true">.*swagger-ui-5\.18\.2\.jar.*</filePath>
        <cve>CVE-2026-49978</cve>
    </suppress>

    <!--
      Безымянные RetireJS-находки для DOMPurify в swagger-ui-5.18.2.jar (без CVE-идентификатора,
      только текстовое описание). Подавляются по паттерну имени уязвимости.
      Обоснование то же: Swagger UI защищён RBAC, доступен только SYSTEM_ADMIN.
    -->
    <suppress>
        <notes>Безымянные DOMPurify XSS-находки RetireJS в swagger-ui-5.18.2.jar без CVE-ID.
        Swagger UI доступен только SYSTEM_ADMIN (Spring Security). Риск принят. Ревью: 2026-12-31.</notes>
        <filePath regex="true">.*swagger-ui-5\.18\.2\.jar.*</filePath>
        <vulnerabilityName regex="true">.*DOMPurify.*</vulnerabilityName>
    </suppress>

</suppressions>

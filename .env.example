# P4-3: пример переменных окружения для секретов.
# Скопировать в .env (gitignored) и задать РЕАЛЬНЫЕ значения для прод-контура.
# Локально/в тестах можно не задавать — application.yml/docker-compose имеют dev-фоллбэки.
# В проде секреты должны приходить из secret-manager (см. docs/security/secrets-management.md),
# .env допустим только для dev/staging.

# --- База данных ---
DB_NAME=eca_db
DB_USERNAME=eca_user
# ОБЯЗАТЕЛЬНО сменить в проде:
DB_PASSWORD=change-me-in-production
# Полный JDBC URL (опционально; по умолчанию собирается из host/порта):
# DB_URL=jdbc:postgresql://db-host:5432/eca_db

# --- JWT ---
# ОБЯЗАТЕЛЬНО сменить в проде: случайная строка >= 256 бит (32+ байт).
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-256-bit-secret
# TTL в мс (опционально, есть дефолты): access 15 мин, refresh 7 дней
# JWT_EXPIRATION_MS=900000
# JWT_REFRESH_EXPIRATION_MS=604800000

# --- Логи ---
# Формат структурных логов: ecs (default) | logstash | gelf
# LOG_STRUCTURED_FORMAT=ecs
